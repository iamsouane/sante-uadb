<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.10</version>
    <relativePath/>
  </parent>

  <groupId>sn.uadb.supervision</groupId>
  <artifactId>sante-uadb</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>sante-uadb</name>
  <description>Supervision et endpoint /health : Eureka, Spring Boot Actuator, états UP/DOWN</description>

  <modules>
    <module>actuator-commun</module>
    <module>eureka-server</module>
    <module>api-gateway</module>
    <module>catalogue-service</module>
    <module>commande-service</module>
    <module>supervision-service</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <!-- Spring Cloud 2025.1.x est le train compatible avec Spring Boot 4.0.x -->
    <spring-cloud.version>2025.1.5</spring-cloud.version>
    <springdoc.version>3.0.3</springdoc.version>
    <!-- Versions relevées après le scan OSV (voir docs/securite.md) -->
    <httpclient5.version>5.6.5</httpclient5.version>
    <httpcore5.version>5.4.4</httpcore5.version>
    <guava.version>33.7.2-jre</guava.version>
    <httpclient4.version>4.5.14</httpclient4.version>
    <jacoco.version>0.8.13</jacoco.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>sn.uadb.supervision</groupId>
        <artifactId>actuator-commun</artifactId>
        <version>${project.version}</version>
      </dependency>
      <!-- Dépendances transitives d'Eureka, figées à des versions vulnérables -->
      <dependency>
        <groupId>com.google.guava</groupId>
        <artifactId>guava</artifactId>
        <version>${guava.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.httpcomponents</groupId>
        <artifactId>httpclient</artifactId>
        <version>${httpclient4.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution><goals><goal>prepare-agent</goal></goals></execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
